{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "14 days",
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "code-server version in the Dockerfiles",
      "managerFilePatterns": [
        "/(^|/)build/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG CODE_SERVER_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "coder/code-server",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Docker Engine version (apt package) in the Dockerfiles",
      "managerFilePatterns": [
        "/(^|/)build/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG DOCKER_VERSION=5:(?<currentValue>\\d+\\.\\d+\\.\\d+)-1~ubuntu"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "docker/cli",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "tod (OneDev CLI) tag and commit in the Dockerfiles",
      "managerFilePatterns": [
        "/(^|/)build/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG TOD_VERSION=(?<currentValue>v\\S+)\\nARG TOD_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "git-tags",
      "depNameTemplate": "onedev/tod",
      "packageNameTemplate": "https://code.onedev.io/onedev/tod.git"
    },
    {
      "customType": "regex",
      "description": "trivy image (tag and digest) in scripts/trivy-scan.sh",
      "managerFilePatterns": [
        "/^scripts/trivy-scan\\.sh$/"
      ],
      "matchStrings": [
        "(?<depName>aquasec/trivy):(?<currentValue>[0-9][^\\s@\"]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "One PR for all templates. A change under build/ needs a new image tag in main.tf (check-tags fails until then).",
      "matchFileNames": [
        "*/build/**"
      ],
      "groupName": "workspace images",
      "prBodyNotes": [
        "Bump the image tag in each changed `<template>/main.tf` before merging."
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "groupName": "dev tools"
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "groupName": "terraform providers"
    },
    {
      "description": "kreuzwerker/docker v4 builds with buildx over the local socket and ignores \"host\" (see main.tf). Stay on v3.",
      "matchManagers": [
        "terraform"
      ],
      "matchPackageNames": [
        "kreuzwerker/docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "OneDev server is 16.4.1; tod 4.3.3+ needs 16.5.11. Remove this rule after the server upgrade.",
      "matchDepNames": [
        "onedev/tod"
      ],
      "allowedVersions": "<4.3.3"
    }
  ]
}
