{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(tod version)",
      "Bash(tod config get:*)",
      "Bash(tod config path)",
      "Bash(tod remote)",
      "Bash(tod get-login-name:*)",
      "Bash(tod get-valid-labels)",
      "Bash(tod get-commit-message-requirement:*)",
      "Bash(tod project:*)",
      "Bash(tod issue list:*)",
      "Bash(tod issue get:*)",
      "Bash(tod issue current-reference)",
      "Bash(tod pr list:*)",
      "Bash(tod pr get:*)",
      "Bash(tod pr current-reference)",
      "Bash(tod build list:*)",
      "Bash(tod build get:*)",
      "Bash(tod build check-spec)"
    ],
    "ask": [
      "Bash(terraform apply:*)",
      "Bash(tofu apply:*)",
      "Bash(hcloud:*)",
      "Bash(docker stack deploy:*)",
      "Bash(docker service update:*)",
      "Bash(docker service scale:*)",
      "Bash(docker node update:*)",
      "Bash(docker context use:*)",
      "Bash(ansible-playbook:*)",
      "Bash(wrangler deploy:*)",
      "Bash(wrangler secret:*)",
      "Bash(coder templates push:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(tod issue create:*)",
      "Bash(tod issue edit:*)",
      "Bash(tod issue change-state:*)",
      "Bash(tod issue link:*)",
      "Bash(tod issue add-comment:*)",
      "Bash(tod issue log-work:*)",
      "Bash(tod issue create-branch:*)",
      "Bash(tod pr create:*)",
      "Bash(tod pr edit:*)",
      "Bash(tod pr approve:*)",
      "Bash(tod pr request-changes:*)",
      "Bash(tod pr merge:*)",
      "Bash(tod pr discard:*)",
      "Bash(tod pr add-comment:*)",
      "Bash(tod pr add-code-comment:*)",
      "Bash(tod code-comment:*)",
      "Bash(tod build run:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(terraform destroy:*)",
      "Bash(tofu destroy:*)",
      "Bash(hcloud server delete:*)",
      "Bash(hcloud volume delete:*)",
      "Bash(hcloud network delete:*)",
      "Bash(hcloud firewall delete:*)",
      "Bash(hcloud primary-ip delete:*)",
      "Bash(hcloud floating-ip delete:*)",
      "Bash(hcloud load-balancer delete:*)",
      "Bash(hcloud zone delete:*)",
      "Bash(hcloud ssh-key delete:*)",
      "Bash(docker stack rm:*)",
      "Bash(docker service rm:*)",
      "Bash(docker node rm:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)",
      "Bash(wrangler delete:*)",
      "Bash(borg delete:*)",
      "Bash(borg prune:*)",
      "Bash(tailscale logout:*)",
      "Read(/etc/claude-code/*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.config/hcloud/**)",
      "Read(~/.local/share/tailscale/**)",
      "Read(~/.wrangler/**)",
      "Read(~/.config/.wrangler/**)",
      "Read(~/.config/coderv2/**)",
      "Read(~/.docker/config.json)",
      "Bash(tod config set:*)",
      "Read(~/.config/tod/**)"
    ]
  }
}
